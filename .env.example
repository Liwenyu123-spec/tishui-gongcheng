# DeepSeek 密钥优先读系统/用户环境变量 DEEPSEEK_API_KEY（也兼容 DEEPSEEKAPIKEY）。
# DEEPSEEK_API_KEY=your_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# RAG_GENERATION_ENABLED=1
# 第一阶段 RAG 测试配置；默认写入 backend/data/rag_chroma_db
# RAG_CHROMA_DIR=H:\Python工程\提水工程项目\backend\data\rag_chroma_db
# RAG_CHROMA_COLLECTION=water_project_knowledge
# 默认 sentence-transformers。模型下载失败时自动回退本地哈希，并在 /knowledge/rag/status 说明原因。
# RAG_EMBEDDING_PROVIDER=sentence-transformers
# RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# RAG_RERANK_ENABLED=1
# RAG_RERANK_MODEL=H:\二阶段\bge-reranker-base
# 规程说明生成最低相关度；低于此分不调用模型，默认 8
# RAG_ASK_MIN_SCORE=8
# 现场照片图文匹配（Chinese-CLIP）；默认读 H:\二阶段\chinese-clip-vit-base-patch16
# PHOTO_CLIP_MODEL=H:\二阶段\chinese-clip-vit-base-patch16
# PHOTO_STORE_DIR=H:\Python工程\提水工程项目\backend\data\site_photos
# DeepSeek 生成模型：deepseek-chat/reasoner 已于 2026-07 下线，当前可选
# deepseek-flash（默认，支持图片输入）或 deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-flash
# DASHSCOPE_API_KEY=your_key_here
# TAVILY_API_KEY=your_key_here
# LANGCHAIN_API_KEY=your_key_here
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=agent_demo
